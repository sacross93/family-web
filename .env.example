# ─────────────────────────────────────────────────────────────
# 포동(Podong) 환경 변수 템플릿
# 이 파일을 복사해서 .env 를 만들고 값을 채우세요:
#   cp .env.example .env
# (.env 는 git 에 커밋되지 않습니다 — 비밀 정보 보관용)
# ─────────────────────────────────────────────────────────────

# PostgreSQL 연결 문자열 (필수)
# 형식: postgresql://<사용자>:<비밀번호>@<호스트>:5432/<DB이름>?schema=public
# 로컬 예시: postgresql://postgres:postgres@localhost:5432/podong?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/podong?schema=public"

# 로그인 세션 서명 키 (필수)
# 아래 명령으로 생성해서 붙여넣으세요:  openssl rand -base64 32
# ⚠️ 사이트 에이전트 토큰의 암호화 키도 이 값에서 파생됩니다(lib/agent/crypto.ts).
#    값을 바꾸면 저장된 에이전트 토큰을 못 읽어요. 배포 시 주의사항은 DEPLOY.md 6절 참고.
AUTH_SECRET=""

# ── Google 로그인 / 캘린더 연동 (선택 — 나중에) ──
# 발급 방법은 REQUIREMENTS.md "구글 로그인 + 캘린더 연동" 참고.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL="http://localhost:3000"

# ── 사이트 에이전트 (선택) ──
# 엔진은 lib/agent/. 자세한 규칙은 AGENTS.md "사이트 에이전트", 배포는 DEPLOY.md 6절.
AGENT_ENABLED="false"          # 기능 스위치. true 일 때만 동작합니다
AGENT_MODEL="gpt-5.6-terra"    # 모델 ID (2026-09-18 실측으로 유효 확인)
AGENT_TOOL_MODE="auto"         # native | json | auto — 네이티브 도구 호출은 실측 확인, auto 는 실패 시 json 강등
AGENT_MAX_STEPS="6"            # 한 턴에 허용하는 모델↔도구 왕복 횟수
AGENT_HISTORY="10"             # 모델에게 다시 보내는 최근 메시지 수
AGENT_CATALOG_MAX_CHARS="4000" # 시스템 프롬프트에 넣는 사이트 목차 길이 상한
AGENT_WEB_SEARCH="true"    # 모델 쪽 내장 웹검색(우리 fetch 가 막힌 사이트를 대신 읽음). 끄려면 false
AGENT_RUN_LOG_DAYS="30"    # 실행 기록(AgentRun) 보관 일수. 지난 것은 다음 실행 때 지워진다
AGENT_LIST_MAX_CHARS="8000"          # 목록 하나가 실어 보낼 본문 총량(제목·보조정보는 제외)
AGENT_TOOL_RESULT_MAX_CHARS="12000"  # 도구 결과 하나의 최대 글자. 루프의 마지막 안전장치
AGENT_FETCH_MAX_CHARS="6000"   # read_url 이 가져온 본문을 자르는 길이

# 에이전트가 내부 API 를 부를 때 쓸 주소. 요청 헤더에서 만들지 않는다(쿠키 유출 방지).
# 비워 두면 AUTH_URL, 그것도 없으면 http://localhost:3000 을 씁니다.
AGENT_ORIGIN="http://localhost:3000"

# 보통은 필요 없습니다 — AgentAuth.accountId 가 비어 있을 때만 쓰는 폴백입니다.
# AGENT_ACCOUNT_ID=""          # chatgpt-account-id 헤더 값 (비밀 아님)
