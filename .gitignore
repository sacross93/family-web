# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 비밀 정보! 절대 커밋 금지 (템플릿 .env.example 만 예외)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 가족이 올린 사진 (로컬 저장, 커밋 제외)
public/uploads/*
!public/uploads/.gitkeep

# Claude Code 로컬 설정
.claude/

# editor / OS
.vscode/
.idea/
*.swp
Thumbs.db

# agent / skill 로컬 도구 파일 (앱과 무관)
.agents/
.neon
skills-lock.json
